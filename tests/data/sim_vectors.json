                  "emissions_before": 80, "emissions_after": 60}},
    {"name": "small external damage lowers welfare (md 2 < t/2... )", "inputs": {"a": 100, "b": 2, "c": 10, "d": 1, "t": 6, "md": 2, "e": 1},
