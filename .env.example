# 로컬 개발용 설정 예시. 이 파일을 .env 로 복사해서 쓴다 (.env 는 Git 에 올라가지 않는다).
#   cp .env.example .env

# 저장소: sqlite(기본, 로컬) | firestore(운영)
# 로컬에서는 sqlite 만 쓴다. FIREBASE_CREDENTIALS_JSON 이 있어도 이 값이 sqlite 면 Firebase 에 접속하지 않는다.
DB_BACKEND=sqlite

# sqlite 파일 위치 (비우면 프로젝트 폴더의 lms.db)
SQLITE_PATH=

# 개발용 테스트 강좌(content/dev_fixtures) 보이기. 1 일 때만 켜진다. 운영 환경에서 켜면 앱이 시작되지 않는다
ECONOVA_DEV_FIXTURES=

# 검토 전 초안 학습자료 미리보기(/preview/...). 1 일 때만 켜진다. 운영 환경에서 켜면 앱이 시작되지 않는다
ECONOVA_CONTENT_PREVIEW=

# 세션 서명 키. 로컬은 비워 둬도 되지만 운영(Render)에서는 반드시 설정한다
SECRET_KEY=

# AI 커리큘럼 상담 (비우면 AI 기능 없이 규칙 기반으로 동작)
OPENAI_API_KEY=
OPENAI_MODEL=

# 평가 정답 키·교사용 검토 문서 폴더 (저장소 밖이어야 함). 비우면 개발: ~/econova-private, 운영: 없음(평가 닫힘)
# 운영(Render)에서는 Secret Files 에 <평가 id>.answers.json 을 올리고 /etc/secrets 를 적는다
ECONOVA_PRIVATE_CONTENT_DIR=

# ECONOVA AI 튜터·오답 설명·토론·추천 설명: off(기본) | mock(개발·테스트 전용, 운영 불가) | openai(서버의 OPENAI_API_KEY 사용)
ECONOVA_AI_PROVIDER=off
# 모델 (비우면 OPENAI_MODEL, 그것도 비우면 gpt-4o-mini)
ECONOVA_AI_MODEL=
# 비용·남용 방지 한도 (보수적인 기본값). 학생별 하루 요청, 전체 하루 요청, 입력 글자 수, 이전 메시지 수, 출력 토큰, 시간 제한(초)
ECONOVA_AI_DAILY_REQUESTS=20
ECONOVA_AI_GLOBAL_DAILY_REQUESTS=300
ECONOVA_AI_MAX_INPUT_CHARS=600
ECONOVA_AI_MAX_HISTORY=6
ECONOVA_AI_MAX_OUTPUT_TOKENS=700
ECONOVA_AI_TIMEOUT_SECONDS=20
# 같은 요청을 다시 받지 않는 시간(초), AI 대화 보존 기간(일, flask --app app ai-purge 로 정리)
ECONOVA_AI_DUPLICATE_SECONDS=20
ECONOVA_AI_RETENTION_DAYS=30
# 이전 LMS AI 상담: 요청 하나에서 부를 수 있는 AI 호출 수 (웹 검색 포함). 하루 한도는 위 ECONOVA AI 한도를 같이 쓴다
ECONOVA_LEGACY_MAX_CALLS_PER_REQUEST=6

# 플랫폼 관리자 부여(flask admin-grant)를 운영에서 실행할 때만 잠시 1 로 둔다. 평소에는 비워 둔다
ECONOVA_ALLOW_ADMIN_BOOTSTRAP=

# 릴리스 계획 서명 키 (32자 이상, 운영 서버와 릴리스 담당자만). 서명된 계획만 --trust-plan 으로 반영할 수 있다
ECONOVA_RELEASE_SIGNING_KEY=

# 로그인 시도 제한 (15분 구간). 앞단 프록시 수를 확인하기 전에는 TRUSTED_PROXY_HOPS 를 0 으로 둔다 (X-Forwarded-For 무시)
ECONOVA_LOGIN_MAX_PER_ACCOUNT_IP=10
ECONOVA_LOGIN_MAX_PER_ACCOUNT=50
ECONOVA_LOGIN_MAX_PER_IP=200
ECONOVA_TRUSTED_PROXY_HOPS=0
# 홉 수 측정용 관리자 진단 화면(/admin/diagnostics/request). 측정할 때만 1, 끝나면 지운다
# ECONOVA_PROXY_DIAGNOSTICS=1

# 학생 저장 한도 (기본값은 docs/operations-readiness.md 표 참고). 예: ECONOVA_QUOTA_SIMULATION_RUNS=200

# 운영 Firebase 키는 로컬 .env 에 넣지 않는다. 개발용 Firebase 프로젝트가 생기면 그 키만 쓴다.
# FIREBASE_CREDENTIALS_JSON=
