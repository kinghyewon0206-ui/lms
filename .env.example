# 로컬 개발용 설정 예시. 이 파일을 .env 로 복사해서 쓴다 (.env 는 Git 에 올라가지 않는다).
#   cp .env.example .env

# 저장소: sqlite(기본, 로컬) | firestore(운영)
# 로컬에서는 sqlite 만 쓴다. FIREBASE_CREDENTIALS_JSON 이 있어도 이 값이 sqlite 면 Firebase 에 접속하지 않는다.
DB_BACKEND=sqlite

# sqlite 파일 위치 (비우면 프로젝트 폴더의 lms.db)
SQLITE_PATH=

# 개발용 테스트 강좌(content/dev_fixtures) 보이기. 1 일 때만 켜진다. 운영 환경에서 켜면 앱이 시작되지 않는다
ECONOVA_DEV_FIXTURES=

# 세션 서명 키. 로컬은 비워 둬도 되지만 운영(Render)에서는 반드시 설정한다
SECRET_KEY=

# AI 커리큘럼 상담 (비우면 AI 기능 없이 규칙 기반으로 동작)
OPENAI_API_KEY=
OPENAI_MODEL=

# 운영 Firebase 키는 로컬 .env 에 넣지 않는다. 개발용 Firebase 프로젝트가 생기면 그 키만 쓴다.
# FIREBASE_CREDENTIALS_JSON=
